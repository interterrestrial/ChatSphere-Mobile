# The HTTPS origin of the Next.js deployment. Leave blank for the development sample inbox.
EXPO_PUBLIC_API_URL=

# The Google OAuth web client ID for the Android sign-in flow.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Use only with a native build configured for FCM. EAS release profiles set this.
EXPO_PUBLIC_ENABLE_PUSH=false

# Enable for local emulator/LAN HTTP testing; use HTTPS for distributed builds.
CHATSPHERE_ALLOW_HTTP=false
